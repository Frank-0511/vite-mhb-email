{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* ── Target y módulos ── */
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,

    /* ── Modo estricto único (MHB-34) ── */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    /* ── Interop y resolución ── */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,

    /* ── Tipos y librerías ── */
    "types": ["node"],
    "lib": ["es2022", "dom", "dom.iterable"]
  },

  /*
   * Cobertura integral del proyecto: configs, scripts, src y tests.
   */
  "include": ["types/**/*.d.ts", "*.config.ts", "scripts/**/*.ts", "src/**/*.ts"],

  /*
   * Excluir artefactos de build y dependencias.
   */
  "exclude": ["node_modules", "dist"]
}
