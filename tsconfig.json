{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    /* ── Modo JS con JSDoc ── */
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,

    /* ── Resolución de módulos ESM (Node.js) ── */
    "module": "nodenext",
    "moduleResolution": "nodenext",

    /* ── Target ── */
    "target": "es2022",

    /* ── Rigor ── */
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,

    /* ── Interop ── */
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* ── Tipos Node.js ── */
    "types": ["node"],

    /* ── Suprimir errores en .d.ts de dependencias ── */
    "skipLibCheck": true,

    /* ── Lib ── */
    "lib": ["es2022", "dom", "dom.iterable"]
  },

  /*
   * MHB-13: Cobertura total de checkJs sobre scripts, configs, src y tests.
   */
  "include": [
    "types/**/*.d.ts",
    "*.config.js",
    "scripts/**/*.js",
    "scripts/**/*.mjs",
    "src/**/*.js"
  ],

  /*
   * Excluir node_modules y dist siempre.
   */
  "exclude": ["node_modules", "dist"]
}
