{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /* ── Rigor estricto para archivos TypeScript (MHB-29 a MHB-33) ── */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "checkJs": false
  },
  "include": ["types/**/*.d.ts", "scripts/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
