{
  "name": "vite-mhb-email",
  "version": "1.2.0",
  "description": "Email template development toolkit integrating Maizzle, Handlebars and Vite",
  "keywords": [
    "email",
    "maizzle",
    "handlebars",
    "vite",
    "template",
    "tailwindcss"
  ],
  "private": true,
  "author": "Frank Villanueva",
  "contributors": [
    {
      "name": "Frank Villanueva",
      "email": "frank05111996@gmail.com",
      "url": "https://github.com/Frank-0511"
    }
  ],
  "homepage": "https://github.com/Frank-0511/vite-mhb-email",
  "bugs": {
    "url": "https://github.com/Frank-0511/vite-mhb-email/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Frank-0511/vite-mhb-email"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "trustedDependencies": [
    "puppeteer"
  ],
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build/build.ts",
    "generate:icons": "node scripts/icons/generate-icon.ts",
    "check-size": "node scripts/validators/check-html-size.ts",
    "check:dist-baseline": "node scripts/validators/dist-baseline/check.ts",
    "update:dist-baseline": "node scripts/validators/dist-baseline/update.ts",
    "validate-email": "node scripts/validators/validate-email-html.ts",
    "cli": "node scripts/cli/cli.ts",
    "lint": "htmlhint \"src/**/*.html\" && eslint scripts/ src/web/ src/emails/ vite.config.ts vitest.config.ts maizzle.config.js maizzle.config.ts && markdownlint-cli2 \"**/*.md\" \"#node_modules\" && node scripts/validators/validate-json.ts && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:task-branch": "node scripts/ai/check-task-branch.ts",
    "prepare": "husky || true",
    "agents:sync": "node scripts/ai/agents-sync.ts",
    "agents:check": "node scripts/ai/agents-check.ts",
    "check:a11y": "node scripts/validators/validate-contrast.ts && node scripts/validators/check-a11y.ts"
  },
  "lint-staged": {
    "scripts/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/web/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/emails/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "{vite,vitest,maizzle}.config.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "{tailwind,tailwind.email,postcss,eslint}.config.{js,ts}": [
      "prettier --write"
    ],
    "src/emails/**/*.html": [
      "htmlhint",
      "prettier --write"
    ],
    "src/web/**/*.html": [
      "htmlhint",
      "prettier --write"
    ],
    "src/emails/templates/*/data.json": [
      "node scripts/validators/validate-json.ts"
    ],
    "**/*.json": [
      "prettier --write"
    ],
    "src/**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "**/*.md": [
      "markdownlint-cli2 --fix",
      "prettier --write"
    ],
    "**/*.{yml,yaml}": [
      "prettier --write"
    ],
    "*.code-workspace": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "globals": "17.12.0",
    "htmlhint": "1.9.2",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@maizzle/framework": "5.5.0",
    "@resvg/resvg-js": "2.6.2",
    "autoprefixer": "10.6.1",
    "handlebars": "4.7.10",
    "lucide": "1.48.0",
    "nodemailer": "10.0.13",
    "postcss": "8.5.28",
    "puppeteer": "25.12.0",
    "tailwindcss": "3.4.19",
    "tailwindcss-preset-email": "1.4.2",
    "vite": "8.3.2"
  }
}
